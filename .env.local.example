# Work Tools — Environment Variables
# Copy this file to .env.local and fill in your values.
# Optionally symlink to ~/.work-tools.env for access from any working directory.

# Harvest PAT — https://id.getharvest.com/developers
HARVEST_ACCESS_TOKEN=
HARVEST_ACCOUNT_ID=

# Daily Planner — Apps Script web app (see skills/daily-planner/references/setup-guide.md)
DAILY_PLANNER_URL=
DAILY_PLANNER_TOKEN=
